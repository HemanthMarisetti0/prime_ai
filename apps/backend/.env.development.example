# Local development settings. Copy to .env.development and fill in. Never commit .env.development.
# Used by `pnpm dev`.

NODE_ENV=development

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PORT=3000

# Read-only PC telemetry (CPU, memory, disks, GPU, battery) shared with the AI.
SYSTEM_MONITOR=true

# Default news edition for top stories: IN, US or GB
NEWS_REGION=IN

# Firebase sign-in. Leave FIREBASE_PROJECT_ID empty to disable sign-in locally.
FIREBASE_PROJECT_ID=
# Comma-separated Google accounts allowed to use P.R.I.M.E. (empty = any verified account).
ALLOWED_EMAILS=

# Not needed locally: the Vite dev server proxies /api.
CORS_ORIGIN=
