# Local development settings. Copy to .env.development and fill in. Never commit .env.development.
# Used by `pnpm dev`.

NODE_ENV=development

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when a model hits its free-tier limit or is unavailable (comma-separated).
# Leave empty for the built-in list, or set to "none" to disable fallback.
GEMINI_FALLBACK_MODELS=

# Keep model "thinking" minimal for faster replies (default true; false restores model defaults)
GEMINI_FAST_THINKING=

PORT=3000

# Read-only PC telemetry (CPU, memory, disks, GPU, battery) shared with the AI.
SYSTEM_MONITOR=true

# Default news edition for top stories: IN, US or GB
NEWS_REGION=IN

# Firebase sign-in. Leave FIREBASE_PROJECT_ID empty to disable sign-in locally.
FIREBASE_PROJECT_ID=
# Comma-separated Google accounts allowed to use P.R.I.M.E. (empty = any verified account).
ALLOWED_EMAILS=

# Not needed locally: the Vite dev server proxies /api.
CORS_ORIGIN=

# Optional: YouTube Data API key (Google Cloud console). Without it, only a YouTube search link is shown.
YOUTUBE_API_KEY=

# Control of this PC (currently: Windows system volume). Windows only.
PC_CONTROL=true
