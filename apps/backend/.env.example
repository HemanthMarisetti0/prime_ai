# Copy to .env and fill in. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# HTTP port for the API
PORT=3000

# Read-only PC telemetry (CPU, memory, disks, GPU, battery) shared with the AI.
# Set to false when the backend runs on a cloud server (it would report the server, not your PC).
SYSTEM_MONITOR=true

# Default news edition for top stories: IN, US or GB
NEWS_REGION=IN

# Allowed browser origin when the frontend is hosted separately (leave empty for local dev)
CORS_ORIGIN=
