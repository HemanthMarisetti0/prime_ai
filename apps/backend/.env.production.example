# Production settings. Copy to .env.production (or set these as environment variables on the host).
# Used by `pnpm start`. The server refuses to start if a required value is missing.

NODE_ENV=production

# Required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when a model hits its free-tier limit or is unavailable (comma-separated).
# Leave empty for the built-in list, or set to "none" to disable fallback.
GEMINI_FALLBACK_MODELS=
FIREBASE_PROJECT_ID=
# Required: comma-separated Google accounts allowed to use P.R.I.M.E.
ALLOWED_EMAILS=
# Required: the deployed frontend's origin, e.g. https://prime.example.com
CORS_ORIGIN=

PORT=3000

# Keep false on a cloud server: telemetry would describe the server, not your PC.
SYSTEM_MONITOR=false

NEWS_REGION=IN

# Optional: YouTube Data API key (Google Cloud console). Without it, only a YouTube search link is shown.
YOUTUBE_API_KEY=

# Keep false on a cloud server: there is no PC of yours to control.
PC_CONTROL=false
