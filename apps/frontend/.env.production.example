# Production build settings for `pnpm build`. Copy to .env.production.
# These values are embedded in the public bundle: never put secrets here.

# Public URL of the deployed backend, e.g. https://prime-api.example.com
VITE_API_URL=

# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
