# Local development settings for `pnpm dev`. Copy to .env.development.
# Leave the Firebase values empty to run without sign-in.

# Empty: the Vite dev server proxies /api to http://localhost:3000.
VITE_API_URL=

# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
